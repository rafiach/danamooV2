<?xml version="1.0" encoding="utf-8"?>

<!-- ROOT: sekarang horizontal -> kolom kiri (kategori) & kolom kanan (nominal + tombol) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- ==================== -->
    <!-- KOLOM KIRI: 6 KATEGORI (vertikal, sempit) -->
    <!-- ==================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btn_cat_food"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/food" />

        <ImageView
            android:id="@+id/btn_cat_transport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/transport" />

        <ImageView
            android:id="@+id/btn_cat_shopping"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/shopping_bag" />

        <ImageView
            android:id="@+id/btn_cat_bill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/bill" />

        <ImageView
            android:id="@+id/btn_cat_entertainment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/controller" />

        <ImageView
            android:id="@+id/btn_cat_other"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_chip_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/coin" />

    </LinearLayout>

    <!-- ==================== -->
    <!-- KOLOM KANAN: HEADER, NOMINAL, GRID TOMBOL, CLEAR+SEND -->
    <!-- ==================== -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANAMOO"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- TOTAL -->
        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Rp 0"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ==================== -->
        <!-- AMOUNT BUTTONS: GRID 2x2 -->
        <!-- ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_add_1k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:text="+1K"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_add_5k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:text="+5K"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_add_10k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:text="+10K"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_add_50k"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:text="+50K"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ==================== -->
        <!-- CLEAR + SEND -->
        <!-- ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:layout_margin="2dp"
                android:background="@drawable/widget_chip_bg_selected"
                android:gravity="center"
                android:text="➤"
                android:textColor="#C8FF25"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>